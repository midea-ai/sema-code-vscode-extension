# 源代码文件（已编译到dist/）
src/**
*.ts
*.tsx

# 桌宠原生工程源码（独立编译并通过 GitHub Releases 分发，运行时由扩展按需下载）
pet/**

# JetBrains 插件工程（独立发布，与 VSCode 扩展完全无关，勿打进 vsix）
jetbrains-plugin/**

# JetBrains 专用 webview 产物（仅供 JB 插件加载，VSCode 运行时不引用）
dist/webview/jb-*

# 本地调试构建的桌宠 zip（生产运行时从 pet-assets Release 按需下载，不打进通用 vsix）
dist/pet/**

# sourcemap 不参与运行时，本地 dist/ 保留即可，无需进 vsix
dist/**/*.map

# IDE / 工具配置目录
.idea/**
.claude/**
.sema/**

# 配置文件
tsconfig*.json
webpack.config.js
.babelrc*
.eslintrc*
.prettierrc*

# 开发依赖和构建文件（全部代码已由 webpack 打进 dist/，ripgrep 运行时优先复用 VS Code 内置）
node_modules/**
.vscode/**
.git/**
.gitignore

# 文档和说明文件
docs/**
*.md
!README.md
# Skill 市场内置资源：本地目录形式的技能靠 SKILL.md 识别，不能被上面的 *.md 剔掉
!resources/**/*.md

# 测试文件
test/**
tests/**
**/*.test.*
**/*.spec.*

# 其他不必要的文件
imgs/sema.gif
.DS_Store
*.log
npm-debug.log*
.npm
.nyc_output
coverage/
download-ripgrep.sh
package-all.sh
scripts/**

# 只保留必需的文件：
# - package.json (插件配置)
# - dist/ (编译后的代码)
# - imgs/ (图标等资源)
# - README.md (插件说明)

*.vsix
*.zip
*.tar.gz
