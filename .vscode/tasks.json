{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "launch-dev-host",
      "type": "process",
      "command": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--inspect-extensions=9333"
      ],
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    }
  ]
}